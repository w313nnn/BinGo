rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'admin' &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('active', false) == true)
      );
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validBookingStatus(status) {
      return status in ['Requested', 'Approved', 'Rejected', 'Assigned', 'Collected', 'Cancelled'];
    }

    match /test/{testDoc} {
      allow read: if true;
      allow write: if false;
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'zone', 'area', 'collectionDays',
          'preferredLanguage', 'updatedAt'
        ]);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'phone', 'zone', 'area', 'collectionDays',
          'preferredLanguage', 'updatedAt'
        ]);
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow get, list: if isAdmin() || isOwner(resource.data.authorUid);
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.points == 0;
      allow update: if isAdmin()
        && (!('authorUid' in resource.data)
          || request.resource.data.authorUid == resource.data.authorUid);
      allow delete: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /recycleSessions/{sessionId} {
      allow get: if (signedIn()
          && !exists(/databases/$(database)/documents/recycleSessions/$(sessionId)))
        || isOwner(resource.data.ownerUid)
        || isAdmin();
      allow list: if isOwner(resource.data.ownerUid) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.verified == false
        && request.resource.data.status == 'Pending Verification'
        && request.resource.data.pointsApproved == null
        && request.resource.data.pointsPending is number
        && request.resource.data.pointsPending >= 0
        && request.resource.data.weightKg is number
        && request.resource.data.weightKg > 0
        && request.resource.data.collectionMethod in ['self_drop_off', 'collector_pickup']
        && request.resource.data.identificationMode in ['simulated', 'manual']
        && request.resource.data.photoAttached is bool
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'residentName', 'userEmail', 'stationName',
          'materialType', 'itemName', 'category', 'itemType', 'condition',
          'icon', 'bin', 'weightKg', 'pointsPending', 'identificationMode',
          'collectionMethod', 'detectedItem', 'confidence', 'suggestedRoute', 'photoAttached',
          'verified', 'pointsApproved', 'status', 'createdAt'
        ]);
      allow update: if isAdmin()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && resource.data.status in ['Pending Verification', 'Logged', 'Verified']
        && (resource.data.status != 'Verified' || request.resource.data.status == 'Verified')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'verified', 'status', 'pointsApproved', 'updatedAt'
        ])
        && request.resource.data.verified is bool
        && request.resource.data.status in ['Verified', 'Rejected']
        && (request.resource.data.status != 'Verified' || request.resource.data.verified)
        && (request.resource.data.status != 'Rejected' || !request.resource.data.verified)
        && (!('pointsApproved' in request.resource.data)
          || request.resource.data.pointsApproved == null
          || (request.resource.data.pointsApproved is number
            && request.resource.data.pointsApproved >= 0
            && request.resource.data.pointsApproved % 1 == 0
            && request.resource.data.verified));
      allow delete: if isAdmin();
    }

    match /pickupBookings/{bookingId} {
      allow get: if (signedIn()
          && !exists(/databases/$(database)/documents/pickupBookings/$(bookingId)))
        || isOwner(resource.data.ownerUid)
        || isAdmin();
      allow list: if isOwner(resource.data.ownerUid) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.recyclingSubmissionId == bookingId
        && exists(/databases/$(database)/documents/recycleSessions/$(request.resource.data.recyclingSubmissionId))
        && get(/databases/$(database)/documents/recycleSessions/$(request.resource.data.recyclingSubmissionId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/recycleSessions/$(request.resource.data.recyclingSubmissionId)).data.collectionMethod == 'collector_pickup'
        && request.resource.data.status == 'Requested'
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'residentName', 'residentEmail', 'recyclingSubmissionId',
          'pickupAddress', 'pickupDate', 'pickupTime', 'status', 'createdAt',
          'updatedAt'
        ])
        && request.resource.data.residentName is string
        && request.resource.data.residentEmail is string
        && request.resource.data.pickupAddress is string
        && request.resource.data.pickupAddress.size() > 0
        && request.resource.data.pickupAddress.size() <= 500
        && request.resource.data.pickupDate is string
        && request.resource.data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.pickupTime is string
        && request.resource.data.pickupTime.matches('^[0-9]{2}:[0-9]{2}$');
      allow update: if isAdmin()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.recyclingSubmissionId == resource.data.recyclingSubmissionId
        && validBookingStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedCollectorUid', 'statusNote', 'updatedAt'
        ])
        && (
          (resource.data.status == 'Requested'
            && request.resource.data.status in ['Approved', 'Rejected'])
          || (resource.data.status == 'Approved'
            && request.resource.data.status == 'Assigned'
            && request.resource.data.assignedCollectorUid is string
            && exists(/databases/$(database)/documents/collectors/$(request.resource.data.assignedCollectorUid)))
          || (resource.data.status == 'Assigned'
            && request.resource.data.status == 'Collected'
            && request.resource.data.assignedCollectorUid == resource.data.assignedCollectorUid)
        );
      allow delete: if isAdmin();
    }

    match /collectors/{collectorUid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /redemptions/{redemptionId} {
      allow get, list: if isAdmin() || isOwner(resource.data.ownerUid);
      allow create, update, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'rating', 'text', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /fleetUpdates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId);
      allow list: if false;
      allow write: if false;
    }
  }
}