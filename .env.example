# Browser key: restrict by your app's referrers and required Maps APIs.
VITE_GOOGLE_MAPS_API_KEY=
# Enable only after the secure callable backend is deployed and verified.
VITE_REDEMPTION_SERVICE_ENABLED=false
# Must match the deployed callable's Firebase region.
VITE_FUNCTIONS_REGION=us-central1

# Leave these disabled until their real services are configured and tested.
VITE_PROFILE_EMAIL_OTP_ENABLED=false
VITE_PROFILE_PHONE_OTP_ENABLED=false
